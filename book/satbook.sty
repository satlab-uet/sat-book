\newtcolorbox{keyidea}[1]{
  enhanced,breakable,
  colback=SoftGray,colframe=black,
  boxrule=0pt,leftrule=2.5pt,
  arc=0pt,left=10pt,right=10pt,top=8pt,bottom=8pt,
  before skip=10pt,after skip=10pt,
  fonttitle=\rmfamily\bfseries\color{black},
  title={#1}
}
\newtcolorbox{designrule}[1]{
  enhanced,breakable,
  colback=SoftGray,colframe=black,
  boxrule=0pt,leftrule=2.5pt,
  arc=0pt,left=10pt,right=10pt,top=8pt,bottom=8pt,
  before skip=10pt,after skip=10pt,
  fonttitle=\rmfamily\bfseries\color{black},
  title={#1}
}
\newtcolorbox{resultbox}[1]{
  enhanced,
  colback=SoftGray,colframe=black,
  boxrule=.6pt,
  arc=1.5pt,left=10pt,right=10pt,top=8pt,bottom=8pt,
  before skip=10pt,after skip=10pt,
  fonttitle=\rmfamily\bfseries\color{black},
  title={#1}
}
\newtcolorbox{summarybox}{
  enhanced,breakable,
  colback=SoftGray,colframe=black,
  boxrule=.6pt,
  arc=1.5pt,left=11pt,right=11pt,top=9pt,bottom=9pt,
  before skip=12pt,after skip=12pt
}

\newtcolorbox{workedexample}[1]{
  enhanced,breakable,
  colback=white,colframe=black,
  boxrule=.6pt,
  arc=1.5pt,left=11pt,right=11pt,top=9pt,bottom=9pt,
  before skip=12pt,after skip=12pt,
  fonttitle=\rmfamily\bfseries\color{black},
  title={Ví dụ tính tay: #1}
}

%--- TikZ diagram styles retain figure colors for diagrams ---
\tikzset{
  satfig/.style={font=\rmfamily\small,text=black},
  satbox/.style={
    draw=Rule,rounded corners=2pt,fill=SoftGray,
    minimum height=8mm,minimum width=12mm,align=center
  },
  satstate/.style={
    circle,draw=Blue,fill=PaleBlue,thick,
    minimum size=8mm,inner sep=1pt,align=center
  },
  sataux/.style={
    circle,draw=Teal,fill=PaleTeal,thick,
    minimum size=7mm,inner sep=1pt,align=center
  },
  sattrue/.style={draw=Teal,fill=PaleTeal,thick,align=center},
  satfalse/.style={draw=Rule,fill=SoftGray,align=center},
  satwarn/.style={draw=Gold,fill=PaleGold,thick,align=center},
  satedge/.style={-{Latex[length=2.1mm]},thick,draw=Teal},
  satdash/.style={-{Latex[length=2.1mm]},thick,dashed,draw=Blue},
  satdim/.style={{Latex[length=1.8mm]}-{Latex[length=1.8mm]},draw=black},
  satlabel/.style={font=\rmfamily\footnotesize,text=black,align=center}
}

