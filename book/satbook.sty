\newcommand{\flowdiagram}[5]{%
\begin{figure}[tb]
\centering
\begin{tikzpicture}[
  node distance=5mm,
  flowstep/.style={draw=Rule,rounded corners=2pt,fill=SoftGray,
    minimum width=24mm,minimum height=13mm,align=center,
    font=\rmfamily\footnotesize,text=black},
  arrow/.style={-{Latex[length=2.2mm]},thick,draw=Teal}
]
\node[flowstep] (a) {#1};
\node[flowstep,right=of a] (b) {#2};
\node[flowstep,right=of b] (c) {#3};
\node[flowstep,right=of c] (d) {#4};
\node[flowstep,right=of d] (e) {#5};
\draw[arrow] (a) -- (b);
\draw[arrow] (b) -- (c);
\draw[arrow] (c) -- (d);
\draw[arrow] (d) -- (e);
\end{tikzpicture}
\caption{Lộ trình lập luận của chương: từ #1, qua #2, #3 và #4, đến #5.}
\end{figure}
}

